# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

# connection_limit and pool_timeout are REQUIRED (see design 3.4).
DATABASE_URL=postgresql://clover:clover@localhost:55432/clover?connection_limit=25&pool_timeout=10
PRISMA_TX_MAX_WAIT_MS=10000
PRISMA_TX_TIMEOUT_MS=5000

# Signs the OAuth state cookie. REQUIRED: generate one with `openssl rand -base64 48` (production needs 43+ real random chars).
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/v1/auth/discord/callback
# Override only for tests against a mock Discord.
# DISCORD_API_BASE=https://discord.com

# Default request budgets per minute (per member when signed in, per IP otherwise), and wrong bot keys per IP.
# RATE_LIMIT_AUTH_PER_MIN=600
# RATE_LIMIT_ANON_PER_MIN=120
# BOT_KEY_FAILS_PER_MIN=20

# Who may read /docs/json: auto (public outside production, off in production) | public | admin | off
# DOCS_ACCESS=auto

# Claim/release requests allowed per member per second (default 5).
# CLAIM_RATE_MAX=5

# Reverse proxy: number of trusted proxies in front of the API (0 = none; X-Forwarded-For is then ignored).
# With 1 the client IP is the last address the proxy appended, so a client cannot forge it. Your proxy must
# SET (not append to) the header: nginx `proxy_set_header X-Forwarded-For $remote_addr;`.
# Or list fixed proxy addresses/CIDRs instead: TRUST_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
# (the old TRUST_PROXY=true is refused at startup).
# TRUST_PROXY_HOPS=1
# TRUST_PROXY_CIDRS=

# Cheap per-IP budget applied before the session lookup (requests per minute per IP, default 6000).
# PREAUTH_LIMIT_PER_MIN=6000

# Sessions: sliding lifetime (refreshed hourly while used) and the hard cap from login. Expired ones are purged daily.
# SESSION_SLIDING_DAYS=30
# SESSION_ABSOLUTE_DAYS=90

# Post-login redirect and Origin check.
FRONTEND_URL=http://localhost:5173

# Comma-separated sha256 hex digests of inbound bot keys (one or two).
# Generate with: npx tsx scripts/hash-bot-key.ts --generate
BOT_API_KEYS=

# bot | fake | off
NOTIFICATIONS_PROVIDER=off
# Only needed when NOTIFICATIONS_PROVIDER=bot
DISCORD_BOT_NOTIFY_URL=
DISCORD_BOT_NOTIFY_SECRET=

# Tests only: admin connection used to create per-file databases.
# TEST_DATABASE_ADMIN_URL=postgresql://clover:clover@localhost:55432/postgres
